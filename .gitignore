# Byte-compiled Python. research/lab/apply-github-metadata.py is meant to be
# run from a clone, and doing so drops a __pycache__/ next to it - which then
# shows up as untracked in the very repo the script exists to tidy up.
__pycache__/
*.py[cod]

# --- Secrets and local credentials: never commit these ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.pfx
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.netrc
.npmrc
.pypirc
credentials.json
secrets.json
service-account*.json
*.key
!*.pub
